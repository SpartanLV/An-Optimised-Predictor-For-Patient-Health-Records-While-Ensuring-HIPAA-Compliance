# =========================
# Secrets (DO NOT COMMIT REAL VALUES)
# =========================

# Internal service-to-service API key (kept inside docker network in secure mode)
API_KEY=123

# JWT signing secret for end-user auth (generate a strong random value!)
# Example generator:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=456
JWT_ALG=HS256
JWT_ISSUER=cse400-auth
JWT_EXP_SECONDS=3600

# Initial admin credentials for the auth service (demo only; change immediately)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USERS_FILE=/data/users.json

# Cookie security: in secure mode (gateway TLS), keep this true.
COOKIE_SECURE=true

# =========================
# Service URLs (internal docker DNS)
# =========================
AUTH_URL=http://auth:8004
PREPROCESS_URL=http://preprocess:8001
PATIENT_STORE_URL=http://patient-store:8002
INFERENCE_URL=http://inference:8003

# Preprocess options
RETURN_OCR_TEXT=false

# =========================
# Patient store DB
# =========================
DATABASE_URL=postgresql+psycopg2://cse400:cse400@db:5432/cse400
STORAGE_DIR=/data/documents

# Optional: encrypt stored documents at rest (Fernet key). Generate via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# =========================
# Inference service model bundle
# =========================
MODEL_BUNDLE_DIR=/app/model_bundle


# =========================
# Gateway (optional)
# =========================
# If set, web-portal will call other services through the gateway (single ingress).
# In Docker Compose, use the internal DNS name 'gateway'.
GATEWAY_URL=https://gateway:8443

# TLS verification mode for web-portal -> gateway TLS.
# - ca     : verify using GATEWAY_CA_CERT (recommended)
# - false  : disable verification (dev-only)
GATEWAY_TLS_VERIFY=ca

# Path inside the web-portal container to Caddy's local CA certificate.
# docker-compose.yml mounts the gateway's caddy_data volume read-only at /caddy.
GATEWAY_CA_CERT=/caddy/caddy/pki/authorities/local/root.crt
